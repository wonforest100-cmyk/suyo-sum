# Supabase 무료 플랜은 7일 동안 요청이 없으면 일시 정지됩니다.
# 3일마다 한 번 가볍게 호출해 정지를 막습니다.
# 저장소 Settings > Secrets and variables > Actions 에
#   SUPABASE_URL, SUPABASE_ANON_KEY 두 값을 등록하세요.
name: Supabase keepalive
on:
  schedule:
    - cron: '17 3 */3 * *'
  workflow_dispatch:
jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping Supabase
        run: |
          curl -fsS -X POST "${{ secrets.SUPABASE_URL }}/rest/v1/rpc/rr_ping" \
            -H "apikey: ${{ secrets.SUPABASE_ANON_KEY }}" \
            -H "Authorization: Bearer ${{ secrets.SUPABASE_ANON_KEY }}" \
            -H "Content-Type: application/json" -d '{}'
